  {no:106, id:"Quraisy", arab:"قريش", ayat:4, juz:30},
  {no:107, id:"Al-Ma'un", arab:"الماعون", ayat:7, juz:30},
  {no:108, id:"Al-Kausar", arab:"الكوثر", ayat:3, juz:30},
  {no:109, id:"Al-Kafirun", arab:"الكافرون", ayat:6, juz:30},
  {no:110, id:"An-Nasr", arab:"النصر", ayat:3, juz:30},
  {no:111, id:"Al-Lahab", arab:"المسد", ayat:5, juz:30},
  {no:112, id:"Al-Ikhlas", arab:"الإخلاص", ayat:4, juz:30},
  {no:113, id:"Al-Falaq", arab:"الفلق", ayat:5, juz:30},
  {no:114, id:"An-Nas", arab:"الناس", ayat:6, juz:30},
];
const JUZ_MAP = {
  1: [1,2],
  2: [2],
  3: [2,3],
  4: [3,4],
  5: [4],
  6: [4,5],
  7: [5,6],
  8: [6,7],
  9: [7,8],
  10: [8,9],
  11: [9,10,11],
  12: [11,12],
  13: [12,13,14],
  14: [15,16],
  15: [17,18],
  16: [18,19,20],
  17: [21,22],
  18: [23,24,25],
  19: [25,26,27],
  20: [27,28,29],
  21: [29,30,31,32,33],
  22: [33,34,35,36],
  23: [36,37,38,39],
  24: [39,40,41],
  25: [41,42,43,44,45],
  26: [46,47,48,49,50,51],
  27: [51,52,53,54,55,56,57],
  28: [58,59,60,61,62,63,64,65,66],
  29: [67,68,69,70,71,72,73,74,75,76,77],
  30: [78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114],
};

let state = {kelas:null, nama:null, surah:null, ayatFrom:1, ayatTo:null, blob:null, detik:0, timer:null, currentJuz:0, currentFeedback:null, nilai:null, feedbackBlob:null, audioContext:null, analyser:null, dataArray:null, animId:null};

function showStep(n){
  document.querySelectorAll('[id^=step]').forEach(el=>el.classList.add('hidden'));
  document.getElementById('riwayatView').classList.add('hidden');
  if(n>=1 && n<=5) document.getElementById('step'+n).classList.remove('hidden');
}
window.showStep=showStep;

async function loadKelas(){
  const {data,error} = await supabase.from('students').select('kelas');
  if(error){ console.error(error); document.getElementById('kelasGrid').innerHTML=`<div class="col-span-3 text-[11px] text-red-500 p-3 bg-red-50 rounded-xl">Error: ${error.message}<br>Jika Invalid API key, cek anon key hardcoded.</div>`; return; }
  const kelasSet=[...new Set((data||[]).map(d=>d.kelas))].sort();
  const grid=document.getElementById('kelasGrid');
  const empty=document.getElementById('kelasEmpty');
  if(kelasSet.length===0){ grid.innerHTML=''; empty.classList.remove('hidden'); return; }
  empty.classList.add('hidden');
  grid.innerHTML=kelasSet.map(k=>`<button onclick="selectKelas('${k}')" class="h-[72px] rounded-[16px] bg-white border font-bold shadow-sm">${k}</button>`).join('');
}
window.selectKelas=async(kelas)=>{
  state.kelas=kelas;
  document.getElementById('kelasLabel').innerText='Kelas '+kelas;
  showStep(2);
  const {data,error} = await supabase.from('students').select('*').eq('kelas',kelas).order('nama');
  if(error){ alert(error.message); return; }
  document.getElementById('namaGrid').innerHTML=(data||[]).map(s=>`<button onclick="selectNama('${s.nama.replace(/'/g,"\'")}')" class="h-[64px] rounded-[16px] bg-white border font-semibold flex items-center gap-2 px-4"><div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">${s.nama.charAt(0)}</div>${s.nama}</button>`).join('');
};
window.selectNama=(nama)=>{
  state.nama=nama;
  localStorage.setItem('current_siswa', JSON.stringify({kelas:state.kelas,nama}));
  document.getElementById('salamNama').innerText='Hai, '+nama+'!';
  showStep(3);
  renderSurahList();
};

window.filterJuz=(juz)=>{
  state.currentJuz=juz;
  document.querySelectorAll('.juzBtn').forEach(b=>{ b.classList.remove('bg-[#16a34a]','text-white'); b.classList.add('bg-white'); if(parseInt(b.dataset.juz)===juz){ b.classList.add('bg-[#16a34a]','text-white'); b.classList.remove('bg-white'); } });
  renderSurahList();
};

function renderSurahList(){
  const q=document.getElementById('searchSurat').value.toLowerCase();
  let list = SURAH;
  if(state.currentJuz!==0){ const allowed = JUZ_MAP[state.currentJuz] || []; list = SURAH.filter(s=>allowed.includes(s.no)); }
  if(q) list = list.filter(s=>s.id.toLowerCase().includes(q) || s.arab.includes(q) || String(s.no).includes(q));
  document.getElementById('surahCount').innerText=list.length+' surat';
  document.getElementById('juzInfo').innerText=state.currentJuz===0 ? '114 surat • Juz 1-30' : 'Juz '+state.currentJuz+' • '+list.length+' surat';
  document.getElementById('surahList').innerHTML=list.map(s=>`<button onclick="selectSurah(${s.no})" class="w-full text-left bg-white rounded-xl border p-3 flex justify-between"><div class="flex gap-3 items-center"><div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-[11px] font-bold">${s.no}</div><div><div class="font-bold text-[13px]">${s.id}</div><div class="text-[10px] text-stone-500">${s.ayat} ayat • Juz ${s.juz} • ${s.arab}</div></div></div><div class="text-stone-300">→</div></button>`).join('');
}
window.renderSurahList=renderSurahList;
window.selectSurah=(no)=>{
  const s=SURAH.find(x=>x.no===no);
  state.surah=s;
  document.getElementById('selectedSurahName').innerText=s.id+' ('+s.arab+')';
  document.getElementById('selectedSurahMeta').innerText=s.ayat+' ayat • Juz '+s.juz;
  document.getElementById('ayatFrom').value=1; document.getElementById('ayatFrom').max=s.ayat;
  document.getElementById('ayatTo').value=s.ayat; document.getElementById('ayatTo').max=s.ayat;
  document.getElementById('ayatRange').classList.remove('hidden');
};
window.confirmSurah=async()=>{
  const from=parseInt(document.getElementById('ayatFrom').value)||1;
  const to=parseInt(document.getElementById('ayatTo').value)||state.surah.ayat;
  state.ayatFrom=from; state.ayatTo=to;
  document.getElementById('surahTitle').innerText=state.surah.id + (from!==1 || to!==state.surah.ayat ? ` ${from}-${to}` : '');
  document.getElementById('surahJuzLabel').innerText='Juz '+state.surah.juz+' • '+state.surah.ayat+' ayat';
  const ayatDiv=document.getElementById('surahArabFull');
  const latinDiv=document.getElementById('surahLatinFull');
  ayatDiv.innerHTML='<div class="text-[12px] text-stone-400">Memuat ayat lengkap...</div>';
  const offline={112:["قُلْ هُوَ اللَّهُ أَحَدٌ","اللَّهُ الصَّمَدُ","لَمْ يَلِدْ وَلَمْ يُولَدْ","وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ"],113:["قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ","مِنْ شَرِّ مَا خَلَقَ","وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ","وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ","وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ"],114:["قُلْ أَعُوذُ بِرَبِّ النَّاسِ","مَلِكِ النَّاسِ","إِلَٰهِ النَّاسِ","مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ","الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ","مِنَ الْجِنَّةِ وَالنَّاسِ"],108:["إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ","فَصَلِّ لِرَبِّكَ وَانْحَرْ","إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ"]};
  if(offline[state.surah.no]){
    const arr=offline[state.surah.no];
    const sliced=arr.slice(from-1,to);
    ayatDiv.innerHTML=sliced.map((a,i)=>`<div class="mb-2"><span class="inline-flex w-6 h-6 rounded-full bg-green-100 text-green-700 text-[10px] items-center justify-center font-bold mr-2">${from+i}</span>${a}</div>`).join('');
    latinDiv.innerHTML='Ayat '+from+'-'+to;
  } else {
    try{ const res=await fetch(`https://api.alquran.cloud/v1/surah/${state.surah.no}/ar.alafasy`); const json=await res.json(); if(json.data && json.data.ayahs){ const ayahs=json.data.ayahs.slice(from-1,to); ayatDiv.innerHTML=ayahs.map(a=>`<div class="mb-3"><span class="inline-flex w-6 h-6 rounded-full bg-green-100 text-green-700 text-[10px] items-center justify-center font-bold mr-2">${a.numberInSurah}</span>${a.text}</div>`).join(''); latinDiv.innerHTML=ayahs.length+' ayat'; } }catch(e){ ayatDiv.innerHTML=`Surat ${state.surah.id} Ayat ${from}-${to}`; }
  }
  resetRecord(); showStep(4);
};
window.toggleAyat=()=>document.getElementById('ayatContainer').classList.toggle('hidden');
function resetRecord(){ state.blob=null; state.detik=0; document.getElementById('timer').innerText='00:00'; document.getElementById('previewArea').classList.add('hidden'); document.getElementById('recordHint').innerText='Tap untuk rekam'; const c=document.getElementById('waveCanvas'); const ctx=c.getContext('2d'); ctx.clearRect(0,0,c.width,c.height); ctx.fillStyle='#fafaf9'; ctx.fillRect(0,0,c.width,c.height); }
let mediaRecorder, audioStream;
async function startRec(){ try{ audioStream=await navigator.mediaDevices.getUserMedia({audio:true}); state.audioContext=new (window.AudioContext||window.webkitAudioContext)(); const source=state.audioContext.createMediaStreamSource(audioStream); state.analyser=state.audioContext.createAnalyser(); state.analyser.fftSize=256; source.connect(state.analyser); state.dataArray=new Uint8Array(state.analyser.frequencyBinCount); drawWaveform(); mediaRecorder=new MediaRecorder(audioStream); const chunks=[]; mediaRecorder.ondataavailable=e=>chunks.push(e.data); mediaRecorder.onstop=()=>{ const blob=new Blob(chunks,{type:'audio/webm'}); state.blob=blob; document.getElementById('audioPreview').src=URL.createObjectURL(blob); document.getElementById('previewArea').classList.remove('hidden'); stopWaveform(); }; mediaRecorder.start(); state.timer=setInterval(()=>{ state.detik++; const m=String(Math.floor(state.detik/60)).padStart(2,'0'); const s=String(state.detik%60).padStart(2,'0'); document.getElementById('timer').innerText=`${m}:${s}`; },1000); document.getElementById('recordHint').innerText='Merekam... gelombang aktif'; document.getElementById('btnRecord').innerText='⏹️'; }catch(e){ alert(e.message); } }
function stopRec(){ if(mediaRecorder && mediaRecorder.state!=='inactive') mediaRecorder.stop(); if(audioStream) audioStream.getTracks().forEach(t=>t.stop()); clearInterval(state.timer); document.getElementById('recordHint').innerText='Preview'; document.getElementById('btnRecord').innerText='🎤'; stopWaveform(); }
function drawWaveform(){ const canvas=document.getElementById('waveCanvas'); const ctx=canvas.getContext('2d'); const w=canvas.width,h=canvas.height; function draw(){ state.animId=requestAnimationFrame(draw); state.analyser.getByteFrequencyData(state.dataArray); ctx.fillStyle='#fafaf9'; ctx.fillRect(0,0,w,h); const bw=(w/state.dataArray.length)*2.5; let x=0; for(let i=0;i<state.dataArray.length;i++){ const bh=state.dataArray[i]/2; ctx.fillStyle='rgb(22,163,74)'; ctx.fillRect(x,(h-bh)/2,bw,bh); x+=bw+1; } } draw(); }
function stopWaveform(){ if(state.animId) cancelAnimationFrame(state.animId); if(state.audioContext) state.audioContext.close(); }
document.getElementById('btnRecord').onclick=()=>{ if(mediaRecorder && mediaRecorder.state==='recording') stopRec(); else startRec(); };
document.getElementById('btnUlangi').onclick=resetRecord;
document.getElementById('btnKirim').onclick=async()=>{
  if(!state.blob) return;
  const btn=document.getElementById('btnKirim'); const status=document.getElementById('uploadStatus');
  btn.disabled=true; btn.innerText='Mengirim...'; status.classList.remove('hidden'); status.innerText='Upload...';
  try{ const label=state.surah.id + (state.ayatFrom!==1 || state.ayatTo!==state.surah.ayat ? `_${state.ayatFrom}-${state.ayatTo}` : ''); const fileName=`setoran/${state.kelas}_${state.nama}_${label}_${Date.now()}.webm`.replace(/\s+/g,'_'); const {error:upErr} = await supabase.storage.from(BUCKET).upload(fileName, state.blob, {contentType:'audio/webm'}); if(upErr) throw upErr; const {data:urlData} = supabase.storage.from(BUCKET).getPublicUrl(fileName); const {error:insErr} = await supabase.from('submissions').insert({nama_siswa: state.nama, kelas: state.kelas, surah: label, audio_url: urlData.publicUrl, durasi: state.detik, status: 'baru'}); if(insErr) throw insErr; document.getElementById('successSurah').innerText=label; showStep(5); }catch(e){ status.innerText='Gagal: '+e.message; alert('Gagal kirim: '+e.message); } finally { btn.disabled=false; btn.innerText='Kirim'; }
};
async function openRiwayat(){ const curr=JSON.parse(localStorage.getItem('current_siswa')||'{}'); if(!curr.nama){ alert('Pilih kelas & nama dulu'); return; } document.querySelectorAll('[id^=step]').forEach(el=>el.classList.add('hidden')); document.getElementById('riwayatView').classList.remove('hidden'); const list=document.getElementById('riwayatList'); list.innerHTML='Memuat...'; const {data,error} = await supabase.from('submissions').select('*').eq('nama_siswa',curr.nama).eq('kelas',curr.kelas).order('created_at',{ascending:false}).limit(20); if(error){ list.innerHTML='<div class="text-red-500 text-[11px]">'+error.message+'</div>'; return; } if(!data||data.length===0){ list.innerHTML='Belum ada setoran'; return; } list.innerHTML=data.map(d=>{ const has=d.feedback_nilai||d.feedback_catatan||d.feedback_audio_url; const badge=d.status==='baru'?'<span class="text-[10px] bg-amber-100 text-amber-700 px-2 py-1 rounded-full font-bold">Menunggu Teachers</span>':`<span class="text-[10px] bg-green-100 text-green-700 px-2 py-1 rounded-full font-bold">${d.feedback_nilai||d.status}</span>`; let fb=''; if(has){ fb=`<div class="mt-3 p-3 rounded-xl border-2 ${d.feedback_nilai==='mumtaz'?'bg-green-50 border-green-300':'bg-blue-50 border-blue-200'}"><div class="text-[11px] font-bold">✅ FEEDBACK TEACHERS - ${(d.feedback_nilai||'').toUpperCase()}</div>${d.feedback_catatan?`<div class="text-[13px] mt-2 bg-white p-2 rounded-lg">📝 ${d.feedback_catatan}</div>`:''}${d.feedback_audio_url?`<div class="mt-2"><audio controls src="${d.feedback_audio_url}" class="w-full h-[40px] border-2 border-green-300 rounded-lg"></audio></div>`:''}</div>`; } return `<div class="bg-white rounded-[16px] border p-4"><div class="flex justify-between"><div class="font-bold text-[13px]">${d.surah}</div><div class="text-[10px] text-stone-500">${new Date(d.created_at).toLocaleDateString('id-ID')}</div></div><div class="mt-2"><audio controls src="${d.audio_url}" class="w-full h-[36px]"></audio></div><div class="mt-2">${badge}</div>${fb}</div>`; }).join(''); }
window.openRiwayat=openRiwayat;
window.closeRiwayat=()=>{ document.getElementById('riwayatView').classList.add('hidden'); showStep(3); };
document.getElementById('btnRiwayat').onclick=openRiwayat;

let tapCount=0, tapTimer;
document.getElementById('btnTeachers').onclick=()=>{ tapCount++; clearTimeout(tapTimer); tapTimer=setTimeout(()=>tapCount=0,1500); if(tapCount>=3){ document.getElementById('teachersPanel').classList.remove('hidden'); document.getElementById('passwordScreen').classList.remove('hidden'); document.getElementById('teachersContent').classList.add('hidden'); document.getElementById('teacherPass').value=''; document.getElementById('passError').classList.add('hidden'); tapCount=0; } };
window.closeTeachers=()=>document.getElementById('teachersPanel').classList.add('hidden');
window.checkPass=()=>{ const p=document.getElementById('teacherPass').value; if(p===TEACHER_PASS){ document.getElementById('passwordScreen').classList.add('hidden'); document.getElementById('teachersContent').classList.remove('hidden'); loadKelasManage(); loadKoreksi(); } else { document.getElementById('passError').classList.remove('hidden'); } };
window.togglePassVisibility=()=>{ const inp=document.getElementById('teacherPass'); inp.type = inp.type==='password' ? 'text' : 'password'; };
window.switchTeacherTab=(tab)=>{ document.getElementById('teacherTabKelas').classList.toggle('hidden',tab!=='kelas'); document.getElementById('teacherTabKoreksi').classList.toggle('hidden',tab!=='koreksi'); };
async function loadKelasManage(){
  const {data,error} = await supabase.from('students').select('kelas');
  if(error){ document.getElementById('kelasManageList').innerHTML=`<div class="text-red-500 text-[11px] p-3 bg-red-50 rounded-xl">Error load kelas: ${error.message}<br>Jalankan SQL fix di bawah di Supabase.</div>`; return; }
  const kelasSet=[...new Set((data||[]).map(d=>d.kelas))].sort();
  const all=await supabase.from('students').select('*').order('nama');
  if(all.error){ document.getElementById('kelasManageList').innerHTML=`<div class="text-red-500 text-[11px]">${all.error.message}</div>`; return; }
  document.getElementById('kelasManageList').innerHTML=kelasSet.map(k=>{ const siswa=(all.data||[]).filter(s=>s.kelas===k); return `<div class="bg-white rounded-xl border p-3"><div class="flex justify-between"><div class="font-bold text-[14px]">Kelas ${k} • ${siswa.length}</div><button onclick="deleteKelas('${k}')" class="text-[11px] text-red-500 font-bold">Hapus</button></div><div class="flex gap-2 mt-2"><input id="inputNama-${k}" placeholder="Nama siswa baru" class="flex-1 h-[36px] rounded-lg border px-3 text-[12px]"><button onclick="addNama('${k}')" class="h-[36px] px-3 rounded-lg bg-stone-900 text-white text-[12px]">Tambah</button></div><div class="mt-2 space-y-1">${siswa.map(s=>`<div class="flex justify-between bg-stone-50 rounded-lg px-3 py-2"><span class="text-[13px]">${s.nama}</span><button onclick="deleteSiswa('${s.id}')" class="text-[11px] text-red-500">Hapus</button></div>`).join('')}</div></div>`; }).join('') || '<div class="text-[12px] bg-white p-4 rounded-xl border">Belum ada kelas. Buat kelas baru di bawah.</div>';
}
window.quickAddKelas=async()=>{
  const k=document.getElementById('inputKelasBaru').value.trim().toUpperCase();
  const status=document.getElementById('tambahStatus');
  if(!k){ status.innerText='Isi nama kelas'; return; }
  const nama=prompt('Nama siswa pertama untuk kelas '+k+'? (wajib)');
  if(!nama){ status.innerText='Batal'; return; }
  status.innerText='Menambah...';
  const {error} = await supabase.from('students').insert({kelas:k,nama:nama.trim()});
  if(error){ status.innerText='Gagal: '+error.message; alert('Gagal tambah kelas: '+error.message+'\n\nJika RLS, jalankan SQL fix students policy.'); return; }
  document.getElementById('inputKelasBaru').value=''; status.innerText='Berhasil!';
  loadKelas(); loadKelasManage();
};
window.addNama=async(kelas)=>{
  const input=document.getElementById(`inputNama-${kelas}`);
  const nama=input.value.trim();
  const status=document.getElementById('tambahStatus');
  if(!nama) return;
  status.innerText='Menambah '+nama+'...';
  const {error} = await supabase.from('students').insert({kelas,nama});
  if(error){ status.innerText='Gagal: '+error.message; alert('Gagal tambah siswa: '+error.message); return; }
  input.value=''; status.innerText='Siswa '+nama+' ditambah!'; loadKelas(); loadKelasManage();
};
window.deleteSiswa=async(id)=>{ if(!confirm('Hapus siswa?')) return; const {error} = await supabase.from('students').delete().eq('id',id); if(error){ alert(error.message); return; } loadKelas(); loadKelasManage(); };
window.deleteKelas=async(kelas)=>{ if(!confirm('Hapus kelas '+kelas+' dan semua siswanya?')) return; const {error} = await supabase.from('students').delete().eq('kelas',kelas); if(error){ alert(error.message); return; } loadKelas(); loadKelasManage(); };
async function loadKoreksi(){ const {data} = await supabase.from('submissions').select('*').order('created_at',{ascending:false}).limit(30); document.getElementById('koreksiList').innerHTML=(data||[]).map(d=>`<button onclick="openFeedback('${d.id}')" class="w-full text-left bg-white rounded-xl border p-3"><div class="font-bold text-[13px]">${d.kelas} • ${d.nama_siswa} • ${d.surah}</div><div class="text-[11px] text-stone-500">${new Date(d.created_at).toLocaleDateString('id-ID')} • ${d.status}</div></button>`).join('')||'<div class="text-[12px] bg-white p-4 rounded-xl border">Belum ada setoran</div>'; }
window.openFeedback=async(id)=>{ const {data} = await supabase.from('submissions').select('*').eq('id',id).single(); state.currentFeedback=data; document.getElementById('feedbackInfo').innerText=data.kelas+' • '+data.nama_siswa+' • '+data.surah; document.getElementById('feedbackAudioPlayer').src=data.audio_url; document.getElementById('inputCatatan').value=data.feedback_catatan||''; state.nilai=data.feedback_nilai||null; document.querySelectorAll('.nilaiBtn').forEach(b=>{ b.classList.remove('bg-[#16a34a]','text-white'); if(b.dataset.nilai===state.nilai) b.classList.add('bg-[#16a34a]','text-white'); }); document.getElementById('feedbackModal').classList.remove('hidden'); };
window.closeFeedbackModal=()=>document.getElementById('feedbackModal').classList.add('hidden');
window.setNilai=(n)=>{ state.nilai=n; document.querySelectorAll('.nilaiBtn').forEach(b=>{ b.classList.remove('bg-[#16a34a]','text-white'); if(b.dataset.nilai===n) b.classList.add('bg-[#16a34a]','text-white'); }); };
let feedbackRec, feedbackChunks;
document.getElementById('btnRecordFeedback').onclick=async()=>{ const btn=document.getElementById('btnRecordFeedback'); if(feedbackRec && feedbackRec.state==='recording'){ feedbackRec.stop(); feedbackRec.stream.getTracks().forEach(t=>t.stop()); btn.innerText='🎤 Rekam'; return; } const stream=await navigator.mediaDevices.getUserMedia({audio:true}); feedbackRec=new MediaRecorder(stream); feedbackChunks=[]; feedbackRec.ondataavailable=e=>feedbackChunks.push(e.data); feedbackRec.onstop=()=>{ const blob=new Blob(feedbackChunks,{type:'audio/webm'}); state.feedbackBlob=blob; const url=URL.createObjectURL(blob); const aud=document.getElementById('feedbackPreview'); aud.src=url; aud.classList.remove('hidden'); }; feedbackRec.start(); btn.innerText='⏹️ Stop'; };
document.getElementById('btnKirimFeedback').onclick=async()=>{ if(!state.currentFeedback || !state.nilai){ alert('Pilih nilai'); return; } const btn=document.getElementById('btnKirimFeedback'); btn.disabled=true; btn.innerText='Mengirim...'; try{ let url=state.currentFeedback.feedback_audio_url||null; if(state.feedbackBlob){ const fileName=`feedback/${state.currentFeedback.id}_${Date.now()}.webm`; await supabase.storage.from(BUCKET).upload(fileName, state.feedbackBlob, {contentType:'audio/webm', upsert:true}); const {data} = supabase.storage.from(BUCKET).getPublicUrl(fileName); url=data.publicUrl; } await supabase.from('submissions').update({status:state.nilai, feedback_nilai:state.nilai, feedback_catatan:document.getElementById('inputCatatan').value, feedback_audio_url:url, feedback_at:new Date().toISOString()}).eq('id',state.currentFeedback.id); closeFeedbackModal(); loadKoreksi(); }catch(e){ alert(e.message); } finally { btn.disabled=false; btn.innerText='Kirim Feedback'; } };

loadKelas();
const juzContainer=document.getElementById('juzChips');
for(let i=2;i<=28;i++){ const btn=document.createElement('button'); btn.className='juzBtn whitespace-nowrap px-3 h-[32px] rounded-full bg-white border font-bold text-[11px]'; btn.dataset.juz=i; btn.innerText='Juz '+i; btn.onclick=()=>filterJuz(i); juzContainer.appendChild(btn); }
const saved=JSON.parse(localStorage.getItem('current_siswa')||'null');
if(saved){ state.kelas=saved.kelas; state.nama=saved.nama; }
</script>
</body>
</html>
