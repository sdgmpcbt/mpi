<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Murajaah - SD Global Mandiri Patrol</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
<script type="importmap">
{"imports": {"@supabase/supabase-js": "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm"}}
</script>
<style>body{font-family:'Poppins',sans-serif} .arab{font-family:'Amiri',serif; line-height:2.2}</style>
</head>
<body class="bg-[#FFFBF0] min-h-screen text-slate-800">
<div class="min-h-screen flex flex-col">
<header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b border-stone-100">
<div class="max-w-[520px] mx-auto px-5 h-[56px] flex items-center justify-between">
<div class="flex items-center gap-2.5"><div class="w-8 h-8 rounded-xl bg-[#16a34a] flex items-center justify-center text-white font-bold">ح</div><div><div class="font-bold text-[14px]">Murajaah</div><div class="text-[10px] text-stone-500">SD Global Mandiri Patrol</div></div></div>
<div class="flex gap-2"><button id="btnRiwayat" class="w-8 h-8 rounded-full bg-stone-100">🕐</button><button id="btnTeachers" class="w-8 h-8 rounded-full bg-stone-100">🎓</button></div>
</div>
</header>
<main class="flex-1 max-w-[520px] w-full mx-auto px-5 py-5">
<div id="step1" class="space-y-4">
<h1 class="text-[20px] font-bold">Assalamu'alaikum! 👋</h1>
<p class="text-[13px] text-stone-500">Pilih kelasmu</p>
<div id="kelasGrid" class="grid grid-cols-3 gap-3"></div>
<div id="kelasEmpty" class="hidden py-12 text-center"><div class="text-4xl">📚</div><div class="font-semibold mt-2">Belum ada kelas</div><div class="text-[12px] text-stone-500">Teachers belum menambah kelas</div></div>
</div>
<div id="step2" class="hidden space-y-4">
<button onclick="showStep(1)" class="text-[12px] font-semibold text-stone-500">← Ganti Kelas</button>
<h1 class="text-[18px] font-bold">Siapa kamu?</h1>
<p id="kelasLabel" class="text-[13px] text-stone-500"></p>
<div id="namaGrid" class="grid grid-cols-2 gap-3"></div>
</div>
<div id="step3" class="hidden space-y-4">
<button onclick="showStep(2)" class="text-[12px] font-semibold text-stone-500">← Ganti Nama</button>
<h1 id="salamNama" class="text-[18px] font-bold"></h1>
<p class="text-[12px] text-stone-500">30 Juz Lengkap • Surat sesuai Juz</p>
<div class="flex gap-2 overflow-x-auto pb-2">
<button onclick="filterJuz(0)" class="juzBtn whitespace-nowrap px-4 h-[36px] rounded-full bg-[#16a34a] text-white font-bold text-[12px]" data-juz="0">Semua 114</button>
<button onclick="filterJuz(30)" class="juzBtn whitespace-nowrap px-4 h-[36px] rounded-full bg-white border font-bold text-[12px]" data-juz="30">Juz 30</button>
<button onclick="filterJuz(29)" class="juzBtn whitespace-nowrap px-4 h-[36px] rounded-full bg-white border font-bold text-[12px]" data-juz="29">Juz 29</button>
<button onclick="filterJuz(1)" class="juzBtn whitespace-nowrap px-4 h-[36px] rounded-full bg-white border font-bold text-[12px]" data-juz="1">Juz 1</button>
</div>
<div id="juzChips" class="flex gap-2 overflow-x-auto pb-2"></div>
<input id="searchSurat" placeholder="Cari surat..." class="w-full h-[44px] rounded-xl border bg-white px-4 text-[13px]" oninput="renderSurahList()">
<div class="flex justify-between text-[11px] text-stone-500"><span id="surahCount">0 surat</span><span id="juzInfo" class="font-bold text-[#16a34a]"></span></div>
<div id="surahList" class="space-y-2 max-h-[45vh] overflow-auto"></div>
<div id="ayatRange" class="hidden bg-white rounded-[16px] border p-4 space-y-3">
<div class="font-bold text-[14px]" id="selectedSurahName"></div>
<div class="text-[11px] text-stone-500" id="selectedSurahMeta"></div>
<div class="grid grid-cols-2 gap-3">
<div><div class="text-[11px] font-bold">DARI AYAT</div><input id="ayatFrom" type="number" min="1" value="1" class="w-full h-[40px] rounded-lg border px-3 text-[13px] mt-1"></div>
<div><div class="text-[11px] font-bold">SAMPAI AYAT</div><input id="ayatTo" type="number" min="1" class="w-full h-[40px] rounded-lg border px-3 text-[13px] mt-1"></div>
</div>
<button onclick="confirmSurah()" class="w-full h-[44px] rounded-full bg-[#16a34a] text-white font-bold text-[13px]">Lanjut Rekam →</button>
</div>
</div>
<div id="step4" class="hidden space-y-4">
<button onclick="showStep(3)" class="text-[12px] font-semibold text-stone-500">← Ganti Surat</button>
<div class="bg-white rounded-[20px] p-4 border shadow-sm">
<div class="flex justify-between"><div><div class="text-[11px] font-bold tracking-widest text-[#16a34a]" id="surahTitle"></div><div class="text-[10px] text-stone-500" id="surahJuzLabel"></div></div><button onclick="toggleAyat()" class="text-[11px] font-bold text-[#16a34a]">Sembunyi</button></div>
<div id="ayatContainer" class="mt-3 max-h-[32vh] overflow-auto">
<div id="surahArabFull" class="arab text-[21px] text-right"></div>
<div id="surahLatinFull" class="text-[12px] text-stone-600 mt-3 italic"></div>
</div>
</div>
<div class="bg-white rounded-[20px] p-5 border shadow-sm text-center">
<div class="text-[11px] font-bold tracking-widest text-stone-400 mb-2">GELOMBANG SUARA • REAL</div>
<canvas id="waveCanvas" width="400" height="80" class="w-full h-[80px] bg-stone-50 rounded-xl border"></canvas>
<div id="timer" class="text-[32px] font-bold mt-3">00:00</div>
<button id="btnRecord" class="mt-4 w-[96px] h-[96px] rounded-full bg-[#16a34a] text-white text-3xl shadow-lg active:scale-95">🎤</button>
<div id="recordHint" class="text-[12px] text-stone-500 mt-3">Tap untuk rekam</div>
<div id="previewArea" class="hidden mt-5">
<audio id="audioPreview" controls class="w-full"></audio>
<div class="grid grid-cols-2 gap-3 mt-4">
<button id="btnUlangi" class="h-[48px] rounded-full bg-stone-100 font-semibold text-[13px]">Ulangi</button>
<button id="btnKirim" class="h-[48px] rounded-full bg-[#16a34a] text-white font-bold text-[13px]">Kirim</button>
</div>
<div id="uploadStatus" class="text-[11px] text-stone-500 mt-3 hidden"></div>
</div>
</div>
</div>
<div id="step5" class="hidden text-center py-10 space-y-4">
<div class="w-20 h-20 mx-auto rounded-full bg-[#16a34a] flex items-center justify-center text-white text-3xl">✓</div>
<h1 class="text-[22px] font-bold">Terkirim! 🎉</h1>
<p class="text-[13px] text-stone-500"><span id="successSurah" class="font-bold"></span> sampai ke Teachers.</p>
<div class="grid grid-cols-2 gap-3 pt-4">
<button onclick="showStep(3)" class="h-[48px] rounded-full bg-stone-100 font-semibold">Setor Lagi</button>
<button onclick="openRiwayat()" class="h-[48px] rounded-full bg-[#16a34a] text-white font-bold">Riwayat</button>
</div>
</div>
<div id="riwayatView" class="hidden space-y-4">
<div class="flex items-center justify-between"><h1 class="text-[20px] font-bold">Riwayat</h1><button onclick="closeRiwayat()" class="w-8 h-8 rounded-full bg-stone-100">✕</button></div>
<div id="riwayatList" class="space-y-3"></div>
</div>
</main>

<!-- Teachers Panel - NO API UI, HIDDEN PASSWORD -->
<div id="teachersPanel" class="hidden fixed inset-0 z-50 bg-black/40 p-4">
<div class="max-w-[520px] mx-auto bg-[#FFFBF0] rounded-[24px] max-h-[90vh] overflow-hidden flex flex-col">
<div class="p-5 border-b flex justify-between items-center"><div class="font-bold">Panel Teachers</div><button onclick="closeTeachers()" class="w-8 h-8 rounded-full bg-stone-200">✕</button></div>
<div id="passwordScreen" class="p-6 space-y-5">
<div class="text-center"><div class="text-4xl">🔐</div><div class="font-bold mt-2">Akses Teachers</div><div class="text-[11px] text-stone-500 mt-1">Masukkan sandi untuk melanjutkan</div></div>
<div class="relative">
<input id="teacherPass" type="password" placeholder="Sandi" class="w-full h-[52px] rounded-xl border bg-white px-4 text-[16px] text-center tracking-[0.4em]">
<button type="button" onclick="togglePassVisibility()" class="absolute right-3 top-[16px] text-[12px] text-stone-400">👁️</button>
</div>
<button onclick="checkPass()" class="w-full h-[48px] rounded-full bg-[#16a34a] text-white font-bold">Masuk</button>
<div id="passError" class="text-[11px] text-red-500 text-center hidden">Sandi salah!</div>
</div>
<div id="teachersContent" class="hidden flex-1 flex flex-col">
<div class="flex border-b text-[12px] font-bold">
<button onclick="switchTeacherTab('kelas')" id="tabKelasBtn" class="flex-1 py-3 bg-white">Kelas & Siswa</button>
<button onclick="switchTeacherTab('koreksi')" id="tabKoreksiBtn" class="flex-1 py-3 text-stone-400">Koreksi</button>
</div>
<div class="flex-1 overflow-auto p-5">
<div id="teacherTabKelas" class="space-y-4">
<div id="kelasManageList" class="space-y-4"></div>
<div class="flex gap-2"><input id="inputKelasBaru" placeholder="Kelas baru cth 3A" class="flex-1 h-[44px] rounded-xl border bg-white px-4 text-[13px]"><button onclick="quickAddKelas()" class="h-[44px] px-5 rounded-xl bg-[#16a34a] text-white font-bold text-[13px]">Buat</button></div>
<div id="tambahStatus" class="text-[11px] text-center"></div>
</div>
<div id="teacherTabKoreksi" class="hidden space-y-3"><div id="koreksiList" class="space-y-3"></div></div>
</div>
</div>
</div>
</div>

<div id="feedbackModal" class="hidden fixed inset-0 z-[60] bg-black/50 p-4 flex items-center justify-center">
<div class="w-full max-w-[520px] bg-white rounded-[24px] p-5 space-y-4 max-h-[90vh] overflow-auto">
<div class="flex justify-between"><div class="font-bold">Koreksi</div><button onclick="closeFeedbackModal()" class="w-8 h-8 rounded-full bg-stone-100">✕</button></div>
<div id="feedbackInfo" class="text-[13px] bg-stone-50 rounded-xl p-3"></div>
<audio id="feedbackAudioPlayer" controls class="w-full"></audio>
<div class="grid grid-cols-2 gap-2"><button onclick="setNilai('mumtaz')" class="nilaiBtn h-[44px] rounded-xl border font-bold text-[12px]" data-nilai="mumtaz">Mumtaz 🌟</button><button onclick="setNilai('jayyid_jiddan')" class="nilaiBtn h-[44px] rounded-xl border font-bold text-[12px]" data-nilai="jayyid_jiddan">Jayyid Jiddan</button><button onclick="setNilai('jayyid')" class="nilaiBtn h-[44px] rounded-xl border font-bold text-[12px]" data-nilai="jayyid">Jayyid</button><button onclick="setNilai('perlu_ulang')" class="nilaiBtn h-[44px] rounded-xl border font-bold text-[12px]" data-nilai="perlu_ulang">Perlu Latihan</button></div>
<textarea id="inputCatatan" placeholder="Catatan Teachers..." class="w-full h-[80px] rounded-xl border p-3 text-[13px]"></textarea>
<div class="flex gap-2"><button id="btnRecordFeedback" class="h-[44px] px-4 rounded-xl bg-stone-100 font-bold text-[12px]">🎤 Rekam</button><audio id="feedbackPreview" controls class="hidden flex-1"></audio></div>
<button id="btnKirimFeedback" class="w-full h-[48px] rounded-full bg-[#16a34a] text-white font-bold">Kirim Feedback</button>
<div id="feedbackStatus" class="text-[11px] text-center"></div>
</div>
</div>
</div>

